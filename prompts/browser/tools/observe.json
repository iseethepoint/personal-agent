{
  "type": "object",
  "properties": {
    "tab": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
    },
    "view": {
      "type": "string",
      "enum": [
        "auto",
        "text",
        "element"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "text",
          "value",
          "href",
          "image_url",
          "role",
          "name",
          "state"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$",
      "description": "An element reference from the current view."
    }
  },
  "required": [
    "tab"
  ],
  "additionalProperties": false
}
